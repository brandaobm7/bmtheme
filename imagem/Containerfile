# Imagem bmos: o Bazzite com o tema bmos já dentro e sem os apps que não servem
# a um computador de jogos com área de trabalho simples.
#
# BASE escolhe a imagem do Bazzite de partida, conforme a placa de vídeo:
#   ghcr.io/ublue-os/bazzite:stable               AMD e Intel
#   ghcr.io/ublue-os/bazzite-nvidia:stable        NVIDIA GTX das séries 900 e 1000
#   ghcr.io/ublue-os/bazzite-nvidia-open:stable   NVIDIA RTX e GTX 1600
#   ghcr.io/ublue-os/bazzite-deck:stable          AMD e Intel, ligando no modo jogo da Steam
ARG BASE=ghcr.io/ublue-os/bazzite:stable

# Etapa de obra, jogada fora no fim: compila o motor da decoração das janelas com
# os cantos de baixo arredondados. Os pacotes instalados para compilar ficam aqui e
# não chegam à imagem. Se a compilação falhar, as peças entregues são as originais.
FROM ${BASE} AS obra
COPY imagem/cantos-da-decoracao.sh imagem/cantos-da-decoracao.py /obra/
RUN bash /obra/cantos-da-decoracao.sh /saida

FROM ${BASE}

LABEL org.opencontainers.image.title="bmtheme" \
      org.opencontainers.image.description="Bazzite com o tema bmos" \
      org.opencontainers.image.source="https://github.com/brandaobm7/bmtheme" \
      org.opencontainers.image.licenses="GPL-3.0-only"

# O tema inteiro fica no sistema. No login de cada usuário, ele é instalado na
# pasta pessoal a partir daqui (ver imagem/primeiro-uso.sh).
COPY . /usr/share/bmtheme
# As duas peças da decoração que a etapa de obra entregou.
COPY --from=obra /saida/org.kde.kwin.aurorae.so /saida/org.kde.kwin.aurorae.v2.so /usr/lib64/qt6/plugins/org.kde.kdecoration3/

# A última etapa confere se o resultado continua sendo uma imagem de sistema válida.
RUN bash /usr/share/bmtheme/imagem/construir.sh && bootc container lint
